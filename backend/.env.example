# Copia este archivo a .env y completa valores locales. Nunca uses credenciales reales en Git.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Optional PEM CA path; relative paths resolve from the backend directory.
# If empty, the bundled backend/certificados/ca (2).pem path is used.
DB_SSL_CA=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo necesario si el frontend y Django usan otro origen y ese origen está autorizado.
CSRF_TRUSTED_ORIGINS=
