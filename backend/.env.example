# Copia este archivo a .env y completa valores locales. Nunca uses credenciales reales en Git.
DB_ENGINE=mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
# Solo necesario si el frontend y Django usan otro origen y ese origen está autorizado.
CSRF_TRUSTED_ORIGINS=
EDUFLOW_MAX_UPLOAD_SIZE=15728640
# El almacenamiento privado debe permanecer fuera de MEDIA_ROOT y STATIC_ROOT.
EDUFLOW_PRIVATE_MEDIA_ROOT=
# Escala institucional de calificación; rango permitido: 0 a este valor.
EDUFLOW_GRADE_MAX=10
